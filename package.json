{
  "name": "econ-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings && prettier --check src scripts .github \"*.{json,ts,mjs,html}\" \".*.json\"",
    "format": "prettier --write src scripts .github \"*.{json,ts,mjs,html}\" \".*.json\"",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "agent:check": "node scripts/agent-check.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "1.87.0",
    "playwright": "1.55.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
